
# ==========================================
# OS DETECTION
# ==========================================

ifeq ($(OS),Windows_NT)
    # Windows (MinGW / MSYS2)
    CC = gcc
    RUN =
    MKDIR = if not exist target mkdir target
    RM = cmd /C "if exist target rmdir /S /Q target"
    PATH_PREFIX =
else
    # Linux (cross-compile for Windows)
    CC = x86_64-w64-mingw32-gcc
    RUN = wine
    MKDIR = mkdir -p target
    RM = rm -rf target
    PATH_PREFIX = ./
endif

# ==========================================
# COMPILER FLAGS
# ==========================================

CFLAGS = -Wall -Wextra -g -Iinclude -MMD -MP
LDLIBS = -lws2_32

# ==========================================
# DIRECTORIES
# ==========================================

SRC_DIR = src
TARGET_DIR = target

# ==========================================
# SOURCES
# ==========================================

SERVER_SRC = $(SRC_DIR)/server.c \
             $(SRC_DIR)/network.c \
             $(SRC_DIR)/game.c \
             $(SRC_DIR)/server_logic.c

CLIENT_SRC = $(SRC_DIR)/client.c \
             $(SRC_DIR)/network.c

TEST_SRC = $(SRC_DIR)/test_protocol.c \
           $(SRC_DIR)/network.c

# ==========================================
# EXECUTABLES
# ==========================================

SERVER = $(TARGET_DIR)/server.exe
CLIENT = $(TARGET_DIR)/client.exe
TEST = $(TARGET_DIR)/test_protocol.exe

# Dependency files generated by GCC
DEPS = $(SERVER:.exe=.d) \
       $(CLIENT:.exe=.d) \
       $(TEST:.exe=.d)

# ==========================================
# BUILD
# ==========================================

all: $(SERVER) $(CLIENT)

$(TARGET_DIR):
	$(MKDIR)

$(SERVER): $(SERVER_SRC) | $(TARGET_DIR)
	$(CC) $(CFLAGS) $(SERVER_SRC) -o $@ $(LDLIBS)

$(CLIENT): $(CLIENT_SRC) | $(TARGET_DIR)
	$(CC) $(CFLAGS) $(CLIENT_SRC) -o $@ $(LDLIBS)

$(TEST): $(TEST_SRC) | $(TARGET_DIR)
	$(CC) $(CFLAGS) $(TEST_SRC) -o $@ $(LDLIBS)

# Include automatically generated header dependencies
-include $(DEPS)

# ==========================================
# RUN
# ==========================================

run-server: $(SERVER)
	$(RUN) $(PATH_PREFIX)$(SERVER)

run-client: $(CLIENT)
	$(RUN) $(PATH_PREFIX)$(CLIENT)

run: all
	$(RUN) $(PATH_PREFIX)$(SERVER)

# ==========================================
# TESTS
# ==========================================

test: $(TEST)
	$(RUN) $(PATH_PREFIX)$(TEST)

# ==========================================
# CLEAN
# ==========================================

clean:
	$(RM)

# ==========================================
# PHONY TARGETS
# ==========================================

.PHONY: all run run-server run-client test clean
